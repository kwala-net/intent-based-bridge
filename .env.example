# ── RPC endpoints (used by Foundry scripts and optionally by frontend) ──────────
SEPOLIA_RPC_URL=
FUJI_RPC_URL=

# ── Deployer wallet (Foundry only — never expose in frontend) ────────────────────
DEPLOYER_PRIVATE_KEY=

# ── Backend / API routes ──────────────────────────────────────────────────────────
# Secret that Kwala must pass in X-Webhook-Secret header on fill + expire webhooks
WEBHOOK_SECRET=change_me

# ── Frontend public vars (bundled into the client) ───────────────────────────────
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_FUJI_RPC_URL=
NEXT_PUBLIC_INTENT_ESCROW_SEPOLIA=
NEXT_PUBLIC_INTENT_ESCROW_FUJI=
NEXT_PUBLIC_MOCK_USDC_SEPOLIA=
NEXT_PUBLIC_MOCK_USDC_FUJI=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
